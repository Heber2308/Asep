  <title><%= title %></title>  <title><%= title %></title>

  <style>  <style>

    * {    * {

      margin: 0;      margin: 0;

      padding: 0;      padding: 0;

      box-sizing: border-box;      box-sizing: border-box;

    }    }



    body {    body {

